{
  "name": "dsh-plugin-session-manager",
  "version": "0.1.3",
  "type": "module",
  "main": "./lib/index.js",
  "description": "DeepSeek Harness session tagging, official archive/pin integration and safe deletion UI",
  "license": "MIT",
  "author": {
    "name": "6jeffr3y",
    "url": "https://github.com/6jeffr3y"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6jeffr3y/dsh-session-manager.git"
  },
  "bugs": {
    "url": "https://github.com/6jeffr3y/dsh-session-manager/issues"
  },
  "homepage": "https://github.com/6jeffr3y/dsh-session-manager#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session-management",
    "session-manager",
    "archive",
    "tagging",
    "ai",
    "llm",
    "agent",
    "developer-tools"
  ],
  "files": [
    "cordis.patch.yml",
    "lib/*.js",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/tools.js && node --test tests/*.test.js",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5"
  }
}
